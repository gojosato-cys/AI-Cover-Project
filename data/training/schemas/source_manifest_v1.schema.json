{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source_manifest_v1.schema.json",
  "title": "RemLocal training source manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "name",
    "source_type",
    "location",
    "usage_scope",
    "status",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "rem-source-v1"},
    "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "source_type": {
      "enum": ["human_authored", "user_provided", "model_assisted", "public_dataset"]
    },
    "location": {"type": "string", "minLength": 1, "maxLength": 500},
    "usage_scope": {"type": "string", "minLength": 1, "maxLength": 200},
    "status": {"enum": ["draft", "approved", "blocked"]},
    "notes": {"type": "string", "maxLength": 1000}
  }
}
